<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Progress Bar Loading -->
    <ProgressBar
        android:id="@+id/progressBarAssetDetail"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutContentAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/txtAssetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asset Order Detail"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#1E1E1E"
                android:layout_marginBottom="12dp" />

            <!-- Asset Info -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F7F8FA"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/txtAssetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asset Transaction Number:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/txtTransferType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transfer Type: -"
                    android:textStyle="bold"
                    android:textColor="#216eff"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/txtFromHolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From: -"
                    android:textColor="#444444"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtToEmployee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To: -"
                    android:textColor="#444444"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtScheduledDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scheduled Date: -"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtOrigin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Origin: -"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="State: -"
                    android:textColor="#555555"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtPartner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Move Lines Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Move Lines"
                android:textStyle="bold"
                android:textColor="#1E1E1E"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAssetMove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
